# Font
font-family = Maple Mono NF CN
font-size = 14

# Theme
theme = Vercel

# Background
background-opacity = 0.85
background-blur-radius = true

# Padding
window-padding-x = 10
window-padding-y = 2,10

# Shell integration
shell-integration-features = no-cursor, ssh-env

# Keybindings
macos-option-as-alt = left
